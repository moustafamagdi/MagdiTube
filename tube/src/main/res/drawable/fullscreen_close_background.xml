<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="6dp">
    <ripple android:color="#50FFFFFF">
        <item>
            <selector>
                <item android:state_focused="true">
                    <shape android:shape="oval">
                        <solid android:color="#88000000" />
                        <stroke android:width="1dp" android:color="#BBFFFFFF" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="oval">
                        <solid android:color="#55000000" />
                        <stroke android:width="1dp" android:color="#40FFFFFF" />
                    </shape>
                </item>
            </selector>
        </item>
        <item android:id="@android:id/mask">
            <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
        </item>
    </ripple>
</inset>
